# 라이브 모델 서버 (Commercial-AI- FastAPI) — **옵트인**.
# 미설정이면 라이브 호출을 아예 시도하지 않고 정적 산출물(model-exports/)을 쓴다.
# Vercel 등 모델 서버가 없는 환경에서는 비워 둘 것 (실패할 fetch 낭비 방지).
# MODEL_SERVER_URL=http://localhost:8000
MODEL_TIMEOUT_MS=8000

# 사전계산 산출물 위치 — 히트맵·메타·상세의 소스
# 기본값: <프로젝트 루트>/model-exports  (레포에 포함되어 배포됨)
# ⚠️ Commercial-AI-/exports 를 가리키지 말 것: 스키마가 달라(cells↔items,
#    sangwonCode↔districtCode) 조용히 빈 히트맵이 된다.
# MODEL_EXPORTS_DIR=

# 카카오맵 JS SDK 키 — 없으면 상권 검색 리스트 폴백 UI로 동작
NEXT_PUBLIC_KAKAO_MAP_KEY=

# "false"로 두면 모델 서버 오류 시 목업 대신 502 반환 (기본: 목업 폴백 on)
MOCK_FALLBACK=true

# ── SNS 언급 분석 (베타, 로컬 전용) ──────────────────────────
# 카드 렌더 게이트 — true 인 환경에서만 리포트에 베타 카드가 보인다.
# ⚠️ Vercel 에 등록하지 말 것 (로컬 테스트 전용 결정, 2026-08-07) — 미등록이면
#    배포본에는 카드 자체가 렌더되지 않는다. NEXT_PUBLIC_ 이므로 빌드 시점 인라인.
# NEXT_PUBLIC_BUZZ_ENABLED=true
#
# 아래 키 셋이 모두 있어야 실제 수집·요약이 동작. 없으면 카드가 "키 미설정" 사유를
# 표시할 뿐 다른 기능에는 영향이 없다. 모두 서버 전용 (브라우저 노출 금지).
# 네이버 검색 API — developers.naver.com 앱 등록(무료, 즉시 발급) 후 발급
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# Claude API — platform.claude.com 에서 발급
# ANTHROPIC_API_KEY=
# 요약에 쓸 모델 (기본 claude-opus-5)
# BUZZ_MODEL=claude-opus-5
